static void animate_stocks(lv_timer_t *timer) {
    // Animate the current labels to move up
    for (int i = 0; i < N; i++) {
        if (labels[i] != NULL) {
            Serial.printf("i = %d\n", i);
            lv_anim_t a;
            lv_anim_init(&a);
            lv_anim_set_var(&a, labels[i]);
            lv_anim_set_values(&a, lv_obj_get_y(labels[i]), lv_obj_get_y(labels[i]) - 80); // Move up by 80 pixels (height of the label)
            lv_anim_set_time(&a, 500);
            lv_anim_set_exec_cb(&a, (lv_anim_exec_xcb_t)lv_obj_set_y);
            lv_anim_start(&a);

            if (lv_obj_get_y(labels[i]) <= -80) { // If the label is out of screen, delete it
                lv_anim_set_ready_cb(&a, anim_del_cb);
            }
        }
    }

    Serial.printf("current = %d\n", current_index);
    // Create new label at the middle position
    int index = (current_index) % (sizeof(stock_names) / sizeof(stock_names[0]));
    lv_obj_t *new_label = create_stock_label(lv_scr_act(), stock_names[index], stock_prices[index], stock_changes[index], stock_is_positive[index]);
    lv_obj_align(new_label, LV_ALIGN_TOP_MID, 0, 160); // Start off-screen at the bottom
#if 0
    // Add fade-in effect for new labels
    lv_obj_set_style_opa(new_label, LV_OPA_TRANSP, 0);
    lv_anim_t fade_in;
    lv_anim_init(&fade_in);
    lv_anim_set_var(&fade_in, new_label);
    lv_anim_set_values(&fade_in, LV_OPA_TRANSP, LV_OPA_COVER);
    lv_anim_set_time(&fade_in, 500);
    lv_anim_set_exec_cb(&fade_in, (lv_anim_exec_xcb_t)lv_obj_set_style_opa);
    lv_anim_start(&fade_in);
#endif
    // Move new label to the middle position
    lv_anim_t a_new;
    lv_anim_init(&a_new);
    lv_anim_set_var(&a_new, new_label);
    lv_anim_set_values(&a_new, 240, 160); // Move to the final position (y = 160)
    lv_anim_set_time(&a_new, 500);
    lv_anim_set_exec_cb(&a_new, (lv_anim_exec_xcb_t)lv_obj_set_y);
    lv_anim_start(&a_new);

    // Shift the labels array and update current index
    for (int i = N - 1; i > 0; i--) {
        labels[i] = labels[i - 1];
    }
    labels[0] = new_label;
    current_index = (current_index + 1) % (sizeof(stock_names) / sizeof(stock_names[0]));
}
#endif
