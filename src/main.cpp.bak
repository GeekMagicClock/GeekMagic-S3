static lv_obj_t *labels[N] = {NULL}; 
static int current_index = 0;
static const char *stock_names[] = {"1 AAPL", "2 TSLA", "3 AMZN", "4 GOOGL", "5 MSFT", "6 FB", "7 NFLX", "8 NVDA", "9 BABA", "10 INTC"};
static const char *stock_prices[] = {"150.25", "620.50", "3200.75", "2700.60", "300.40", "355.30", "590.20", "650.50", "200.00", "55.30"};
static const char *stock_changes[] = {"+1.5%", "-0.8%", "+2.3%", "+0.5%", "-1.0%", "+1.2%", "-2.0%", "+3.5%", "-1.8%", "+0.9%"};
static bool stock_is_positive[] = {true, false, true, true, false, true, false, true, false, true};

static lv_obj_t *create_stock_label(lv_obj_t *parent, const char *stock_name, const char *price, const char *change, bool is_positive) {
    lv_obj_t *label = lv_label_create(parent);
    lv_obj_set_size(label, 230, 70); // Assuming each label takes 60px height
    lv_obj_set_style_radius(label, 5, 0); // Set corner radius
    lv_obj_set_style_bg_color(label, lv_color_hex(0x202020), 0);
    lv_obj_set_style_bg_opa(label, LV_OPA_COVER, 0);
    lv_obj_set_style_text_color(label, lv_color_hex(0xffffff), 0);
    lv_obj_set_style_pad_all(label, 10, 0); // Padding for text inside the label

    char text_buf[100];
    snprintf(text_buf, sizeof(text_buf), "%s\nPrice: %s Change: %s", stock_name, price, change);
    lv_label_set_text(label, text_buf);

    lv_color_t color = is_positive ? lv_color_hex(0x00ff00): lv_color_hex(0xff0000);
    lv_obj_set_style_text_color(label, color, LV_PART_MAIN);

    return label;
}
// Custom animation callback to delete object
static void anim_del_cb(lv_anim_t *a) {
    lv_obj_del((lv_obj_t *)a->var);
}
